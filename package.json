{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@types/react-dom": "^18.2.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
      "start": "vite",
      "dev": "vite",
      "build": "npm run check && vite build",
      "preview": "vite preview",
      "check:duplicates": "node scripts/check-duplicates.ts",
      "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
      "test": "vitest run",
      "test:watch": "vitest",
      "check": "npm run typecheck && npm run check:duplicates && npm test"
  },

  "devDependencies": {
    "@types/node": "^22.20.5",
